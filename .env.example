# Local Quarkus dev configuration; Compose supplies its own container environment.

# Database (required)
DB_USERNAME=backend
DB_PASSWORD=
DB_REACTIVE_URL=mysql://localhost:3306/jp_vocabulary_dev

# JWT verification (optional application defaults)
AUTH_SERVER_URL=http://localhost:8083
AUTH_JWKS_URL=http://localhost:8083/.well-known/jwks.json
AUTH_JWT_ISSUER=JapaneseLearning.User
AUTH_JWT_AUDIENCE=JapaneseLearning
AUTH_JWKS_CACHE_TTL=10M

# Application defaults
APP_SERVICE_NAME=quarkus-service
# Optional instance label; otherwise uses container HOSTNAME, then unknown.
# APP_INSTANCE_ID=vocabulary-api-01
VOCABULARY_IMPORT_MAX_BATCH_SIZE=500

# Logging and telemetry (optional application defaults)
ROOT_LOG_LEVEL=INFO
APP_LOG_LEVEL=INFO
APP_LOG_FILE_ENABLED=true
APP_LOG_DIR=logs
APP_LOG_FILE=application.json.log
APP_LOG_ROTATION_SIZE=50M
APP_LOG_MAX_BACKUPS=100
APP_LOG_RETENTION_DAYS=30
# Profile-dependent: development in dev mode, production in containers.
# APP_ENVIRONMENT=production
APP_SLOW_OPERATION_MS=1000
APP_LOG_CONSOLE_JSON=true
APP_LOG_FILE_JSON=true
APP_OTEL_EXPORT_ENABLED=false
APP_OTEL_SAMPLE_RATIO=0.1

# Dockerfile runtime defaults (keep container listener and launcher aligned)
# QUARKUS_HTTP_HOST=0.0.0.0
# QUARKUS_HTTP_PORT=8080
# APP_LOG_DIR=/deployments/data/logs
# JAVA_APP_JAR=/deployments/quarkus-run.jar
# JAVA_OPTS_APPEND=-Djava.util.logging.manager=org.jboss.logmanager.LogManager
